# Copy to `.env` on the server and fill in. Never commit the real .env.

# --- Django ---------------------------------------------------------------
# Generate a fresh one for production, do not reuse the development key:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.dz,www.example.dz

# --- Database (cPanel > MySQL Databases) ----------------------------------
# cPanel prefixes both with your account name, e.g. cpaneluser_bdg.
DB_NAME=cpaneluser_bdg
DB_USER=cpaneluser_bdguser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- The frontend's origin ------------------------------------------------
# Where the React site is served from. Both are comma-separated.
CORS_ALLOWED_ORIGINS=https://www.example.dz
CSRF_TRUSTED_ORIGINS=https://www.example.dz

# --- HTTPS ----------------------------------------------------------------
# Leave the redirect on once the certificate works. Turn HSTS on only after
# HTTPS is confirmed working: it is hard to undo (31536000 = one year).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
